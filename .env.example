# Environment variables for semantic-search-engine
# Copy this file to .env and adjust the values if needed.

# PostgreSQL + pgvector database
DB_NAME=semantic_search
DB_USER=pablo
DB_PASSWORD=password

# Backend port (informational only, mapped in docker-compose.yml)
BACKEND_PORT=8080

# Frontend port (informational only, mapped in docker-compose.yml)
FRONTEND_PORT=80
